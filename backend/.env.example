# Wick Wax & Relax — example environment file.
# Copy to backend/.env and replace every placeholder before starting the app.
# DO NOT commit the real .env — see .gitignore.

# --- Runtime --------------------------------------------------------------
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# --- Database (PostgreSQL) ------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wick_wax_relax
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# CA bundle for the DB server cert (production). Optional — leave blank to
# use the system trust store (suitable for publicly trusted certs).
DB_CA_CERT_PATH=

# --- Redis ----------------------------------------------------------------
# Local Redis: use the host/port block.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# TLS for managed Redis (Upstash, Redis Cloud, Elasticache).
REDIS_TLS=false
# Or provide a full URL (overrides host/port/password/db).
# REDIS_URL=redis://username:password@host:port

# --- CDN / Frontend -------------------------------------------------------
CDN_URL=https://cdn.example.com
FRONTEND_URL=http://localhost:3000

# --- JWT (REQUIRED in production) ----------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-strong-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-different-secret-min-32-chars

# --- Email (SMTP) ---------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-app-password

# --- Monitoring -----------------------------------------------------------
SENTRY_DSN=

# --- Revolut --------------------------------------------------------------
REVOLUT_API_URL=https://api.revolut.com
REVOLUT_API_KEY=your_revolut_api_key
# Generate with: openssl rand -base64 32
REVOLUT_WEBHOOK_SECRET=your_revolut_webhook_secret

# --- Royal Mail -----------------------------------------------------------
ROYAL_MAIL_API_URL=https://api.royalmail.com
ROYAL_MAIL_API_KEY=your_royal_mail_api_key
ROYAL_MAIL_CLIENT_ID=your_client_id
ROYAL_MAIL_CLIENT_SECRET=your_client_secret

# --- Push notifications ---------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Security -------------------------------------------------------------
BCRYPT_ROUNDS=12

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# --- Cache ----------------------------------------------------------------
CACHE_TTL=3600
FALLBACK_CACHE_TTL=7200

# --- Image processing -----------------------------------------------------
IMAGE_QUALITY=85
THUMBNAIL_SIZE=300
MAX_IMAGE_WIDTH=1200
MAX_IMAGE_HEIGHT=1200
